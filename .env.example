# ========================================================
# DevOps Career Hub - পরিবেশ চলক কনফিগারেশন (.env.example)
# ========================================================

# 1. অ্যাপ বেস ইউআরএল
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. ফায়ারবেস ক্লায়েন্ট সাইড কনফিগারেশন (Firebase Web App)
# Firebase Console > Project Settings > General > Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 3. ফায়ারবেস অ্যাডমিন এসডিকে (Firebase Admin SDK Server-Side)
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# বি.দ্র. Vercel এ যুক্ত করার সময় বা .env ফাইলে নতুন লাইনগুলোকে '\n' হিসেবে রাখুন:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# 4. মঙ্গোডিবি অ্যাটলাস ক্লাউড ডেটাবেস (MongoDB Atlas)
# MongoDB Atlas > Databases > Connect > Drivers (Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=devops_career_hub

# 5. ক্লাউডিনারি ফাইল স্টোরেজ (Cloudinary Document Vault)
# Cloudinary Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. সার্ভার সেশন এনক্রিপশন কি (Session Security)
# যেকোনো দীর্ঘ ও নিরাপদ ৩২ ক্যারেক্টারের স্ট্রিং
SESSION_SECRET=devops-career-hub-super-secret-random-key-32-chars-long
